# Root allowlist: source code and documentation only.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/.gitmodules
!/mouse-spoofing/
!/mouse-generator
!/tools/
!/environment/
!/tests/

/tools/*
!/tools/*.py
/environment/*
!/environment/*.gd
!/environment/*.gdshader
!/environment/*.tscn
!/environment/*.godot
!/environment/*.ps1
!/environment/README.txt

**/__pycache__/
**/.godot/
**/*.pyc
**/.env
**/.env.*
**/*token*
**/*secret*
**/*.pt
**/*.onnx
**/*.log
**/*.zip
**/*.cache
